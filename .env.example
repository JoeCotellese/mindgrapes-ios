# ABOUTME: Template for the release-only secrets that must never be committed.
# ABOUTME: Copy to .env (gitignored), fill in, and `set -a; . ./.env; set +a` before `make release`.

# These four are needed ONLY to ship a build to App Store Connect. Nobody needs
# them to build or run the app: `make build` runs in the simulator with no
# signing and no account. See CONTRIBUTING.md "Releasing".

# App Store Connect API key, created at:
#   https://appstoreconnect.apple.com/access/integrations/api
# ASC_KEY_ID is the key's ten-character ID; ASC_ISSUER_ID is the issuer UUID
# shown above the key list; ASC_KEY_PATH points at the .p8 you downloaded once.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/path/to/AuthKey_XXXXXXXXXX.p8

# Your Apple Developer Team ID (Membership details in the developer portal).
# Signs the export; also what a device build needs (see Signing.xcconfig).
DEVELOPMENT_TEAM=
